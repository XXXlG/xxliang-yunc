<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xxliang.yunc</groupId>
        <artifactId>yunc-service</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>yunc-service-pay</artifactId>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <!--     公共依赖导入 -->
        <dependency>
            <groupId>com.xxliang.yunc</groupId>
            <artifactId>yunc-basic-dependency</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!--       pojo层导入.....  -->
        <dependency>
            <groupId>com.xxliang.yunc</groupId>
            <artifactId>yunc-pojo-pay</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <!--        pojo-->
        <dependency>
            <groupId>com.xxliang.yunc</groupId>
            <artifactId>yunc-resources-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!--整合Redis , 底层可以用jedis-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <!--            排除lettuce-core 在高并发的时候 有内存泄露的问题 -->
            <exclusions>
                <exclusion>
                    <groupId>io.lettuce</groupId>
                    <artifactId>lettuce-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--    使用自定义的 jedis -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xxliang.yunc</groupId>
            <artifactId>yunc-api-search</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.0.4</version>
        </dependency>
        <dependency>
            <groupId>com.xxliang.yunc</groupId>
            <artifactId>yunc-pojo-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.alipay.sdk/alipay-easysdk -->
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-easysdk</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>com.xxliang.yunc</groupId>
            <artifactId>yunc-api-order</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>
</project>